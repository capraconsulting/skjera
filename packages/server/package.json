{
  "name": "@skjera/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./routes": "./src/routes.ts"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/main.ts",
    "build": "node build.ts",
    "start": "node --import tsx src/main.ts",
