{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": ["DATABASE_URL", "OAUTH_*", "AUTH_*", "S3_*", "CI"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {},
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^test:e2e"]
    }
  }
}
