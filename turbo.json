{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "OAUTH_*",
    "AUTH_*",
    "S3_*",
    "EMAIL_*",
    "AWS_*",
    "SES_*",
    "SITE_*",
    "SIGNING_SECRET",
    "CI"
  ],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {},
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^test:e2e"]
    }
  }
}
