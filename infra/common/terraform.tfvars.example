# Region, account, environment and deployment_role_arn are generated from
# bootstrap in bootstrap.auto.tfvars.json (see ../Readme.md).
kubernetes_version = "1.35"
availability_zones = ["eu-north-1a", "eu-north-1b"]

admin_principal_arn = "arn:aws:iam::123456789012:role/YourAdminRole"
api_access_cidrs    = ["203.0.113.10/32"] # Replace with your office/VPN public IP.
