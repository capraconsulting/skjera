{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "OAUTH_*",
    "AUTH_*",
    "S3_*",
    "EMAIL_*",
    "AWS_*",
    "SES_*",
    "SITE_*",
    "SIGNING_SECRET",
    "SKJERA_TEST_SERVER_URL",
    "WEBSITE_ORIGINS",
    "MAILPIT_UI_ADDRESS",
    "CI"
  ],
  "tasks": {
    "compile": {
      "inputs": ["project.inlang/**", "messages/**"],
      "outputs": ["src/paraglide/**"]
    },
    "build": {
      "dependsOn": ["^compile"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["compile", "^compile"]
    },
    "test": {
      "dependsOn": ["compile", "^compile"]
    },
    "@skjera/server#test": {
      "dependsOn": ["compile", "^compile"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/acceptance/**"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^test:e2e"]
    }
  }
}
